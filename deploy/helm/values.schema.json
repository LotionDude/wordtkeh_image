{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "config"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "commonLabels": {
      "type": "object",
      "propertyNames": {
        "not": {
          "pattern": "^(app\\.kubernetes\\.io/|helm\\.sh/)"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "propertyNames": {
        "not": {
          "pattern": "^app\\.kubernetes\\.io/"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "podAnnotations": {
      "type": "object",
      "propertyNames": {
        "not": {
          "const": "checksum/config"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tls": {
          "type": "object",
          "properties": {
            "termination": {
              "const": "edge"
            },
            "insecureEdgeTerminationPolicy": {
              "enum": [
                "Redirect",
                "None",
                "Allow"
              ]
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "config": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string"
        },
        "epochDate": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "historyJournal": {
          "type": "object",
          "properties": {
            "left": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 280
                },
                "translations": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "body": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 280
                      }
                    },
                    "required": [
                      "title",
                      "body"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "title",
                "body"
              ],
              "additionalProperties": false
            },
            "right": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 280
                },
                "translations": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "body": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 280
                      }
                    },
                    "required": [
                      "title",
                      "body"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "title",
                "body"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "streakSchedule": {
          "type": "object",
          "properties": {
            "activeWeekdays": {
              "default": [
                0,
                1,
                2,
                3,
                4
              ],
              "maxItems": 7,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "excludedDates": {
              "default": [],
              "maxItems": 10000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": [
                  "date"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "streaks": {
          "type": "object",
          "properties": {
            "initialFreezes": {
              "default": 3,
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "maxFreezes": {
              "default": 5,
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "playsPerFreezeEarned": {
              "default": 5,
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "playStreakMilestones": {
              "default": [
                3,
                7,
                14,
                30,
                50,
                100
              ],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            },
            "winStreakMilestones": {
              "default": [
                3,
                7,
                14,
                30,
                50,
                100
              ],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            }
          },
          "additionalProperties": false
        },
        "releases": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "changelog": {
                "minItems": 1,
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "id": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "release",
                  "feature",
                  "update"
                ]
              },
              "features": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              },
              "translations": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "changelog": {
                      "minItems": 1,
                      "maxItems": 30,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    }
                  },
                  "required": [
                    "title",
                    "changelog"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "title",
              "changelog",
              "id",
              "version",
              "date",
              "type"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "timezone",
        "epochDate"
      ],
      "additionalProperties": false
    }
  }
}
